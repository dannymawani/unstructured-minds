# Copy to .env and fill in values

# Claude API (optional - app works without it)
ANTHROPIC_API_KEY=sk-ant-...

# Cloud mode: uncomment DATABASE_URL to enable Postgres as source of truth
# DATABASE_URL=postgresql://user:pass@host:port/db

# Paths (local mode)
VAULT_PATH=../vault
DATA_PATH=../data

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Default user ID for single-user mode (UUID)
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
