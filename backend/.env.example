# Copy to .env and fill in values
# (Or use the root .env.example which is more comprehensive)

# LLM provider (optional — app works without it)
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...

# Storage: "local" (DuckDB) or "postgres"
STORAGE_MODE=local
# DATABASE_URL=postgresql://user:pass@host:port/db

# Paths (local mode)
VAULT_PATH=../vault
DATA_PATH=../data

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Auth: "none" (default), "basic", or "clerk"
# AUTH_MODE=none
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=changeme
# CLERK_SECRET_KEY=sk_test_...
# CLERK_DOMAIN=your-app.clerk.accounts.dev
