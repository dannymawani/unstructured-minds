{
  "name": "food_log",
  "description": "Meal and nutrition tracking",
  "columns": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "Composite key: {date}_{meal_type}_{index} (e.g., 20260115_breakfast_1)"
    },
    {
      "name": "date",
      "type": "date",
      "required": true,
      "format": "YYYY-MM-DD"
    },
    {
      "name": "meal_type",
      "type": "string",
      "required": true,
      "allowed_values": ["breakfast", "lunch", "dinner", "snack"]
    },
    {
      "name": "time",
      "type": "time",
      "required": false,
      "format": "HH:MM"
    },
    {
      "name": "description",
      "type": "string",
      "required": true,
      "description": "Description of what was eaten"
    },
    {
      "name": "calories",
      "type": "integer",
      "required": false
    },
    {
      "name": "protein_g",
      "type": "integer",
      "required": false
    },
    {
      "name": "carbs_g",
      "type": "integer",
      "required": false
    },
    {
      "name": "fat_g",
      "type": "integer",
      "required": false
    },
    {
      "name": "notes",
      "type": "string",
      "required": false
    },
    {
      "name": "source_file",
      "type": "string",
      "required": false,
      "description": "Path to the markdown file this was extracted from"
    }
  ]
}
