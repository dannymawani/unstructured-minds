{
  "name": "activities",
  "description": "Training sessions/activities. Each activity contains multiple exercises in exercise_log.",
  "columns": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "Unique activity identifier: YYYYMMDD_type_index (e.g., 20260115_str_1)"
    },
    {
      "name": "date",
      "type": "date",
      "required": true,
      "format": "YYYY-MM-DD"
    },
    {
      "name": "activity_type",
      "type": "string",
      "required": true,
      "allowed_values": ["strength", "bjj", "cardio", "yoga", "walk", "recovery", "other"],
      "description": "Type of training activity"
    },
    {
      "name": "duration_minutes",
      "type": "integer",
      "required": false
    },
    {
      "name": "notes",
      "type": "string",
      "required": false
    },
    {
      "name": "source_file",
      "type": "string",
      "required": false,
      "description": "Path to the markdown file this was extracted from"
    }
  ]
}
