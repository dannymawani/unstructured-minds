{
  "name": "tasks",
  "description": "Tasks from daily notes with status tracking",
  "columns": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "Composite key: {date}_{task_hash} based on task text"
    },
    {
      "name": "date",
      "type": "date",
      "required": true,
      "format": "YYYY-MM-DD"
    },
    {
      "name": "description",
      "type": "string",
      "required": true,
      "description": "Task description text"
    },
    {
      "name": "status",
      "type": "string",
      "required": true,
      "allowed_values": ["pending", "completed", "cancelled"]
    },
    {
      "name": "completed_at",
      "type": "timestamp",
      "required": false,
      "description": "When the task was completed"
    },
    {
      "name": "category",
      "type": "string",
      "required": false
    },
    {
      "name": "priority",
      "type": "integer",
      "required": false,
      "min": 1,
      "max": 3,
      "description": "Priority level 1-3 (1=high, 3=low)"
    },
    {
      "name": "source_file",
      "type": "string",
      "required": false,
      "description": "Path to the markdown file this was extracted from"
    }
  ]
}
