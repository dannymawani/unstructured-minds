# =============================================================================
# Unstructured Minds - Environment Configuration
# =============================================================================
#
# Copy this file to .env and customize as needed:
#   cp .env.example .env
#
# =============================================================================

# =============================================================================
# DATA PATHS
# =============================================================================

# Path to your markdown notes vault
# Default: ./vault (relative to project root)
# Examples:
#   - Local:  ./vault
#   - macOS:  /Users/username/Documents/Notes
#   - Linux:  /home/username/notes
#   - Docker: Use bind mount in docker-compose.yml
VAULT_PATH=./vault

# Path for data storage (DuckDB database)
# Default: ./data (relative to project root)
DATA_PATH=./data

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# API host binding
# Use 0.0.0.0 for Docker or external access
# Use 127.0.0.1 for local-only access
HOST=0.0.0.0

# API port
PORT=8000

# Frontend port (production only, when using nginx)
# Change if port 80 is already in use
FRONTEND_PORT=80

# CORS allowed origins (comma-separated)
# Default: http://localhost:3000,http://localhost:5173
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable debug mode
# - Hot reload for backend
# - Verbose logging
# - Detailed error messages
# Set to 'true' for development, 'false' for production
DEBUG=false

# =============================================================================
# CLAUDE API (Optional)
# =============================================================================
#
# Anthropic API key for Claude integration
# Required for:
#   - AI-powered data extraction from notes
#   - Natural language queries
#   - Smart suggestions
#
# The app works without it but AI features will be disabled.
#
# Get your API key at: https://console.anthropic.com/
# Pricing: https://www.anthropic.com/pricing
#
ANTHROPIC_API_KEY=

# =============================================================================
# CLOUD MODE (Postgres as source of truth)
# =============================================================================
#
# Set USE_CLOUD=true to store vault files and data in Postgres.
# When false (default), files are stored locally at VAULT_PATH / DATA_PATH.
# Cloud mode requires CLERK_SECRET_KEY and CLERK_DOMAIN for authentication.
#
USE_CLOUD=true
DATABASE_URL=postgresql://user:pass@host:port/db

# =============================================================================
# ADVANCED OPTIONS (rarely need to change)
# =============================================================================

# Model selection
# EXTRACTION_MODEL=claude-haiku-4-5-20251001
# QUERY_MODEL=claude-sonnet-4-5-20250929

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Maximum file size for extraction (bytes)
# MAX_FILE_SIZE=1048576

# =============================================================================
# DOCKER-SPECIFIC (only when running in containers)
# =============================================================================

# Compose project name (affects container names)
# COMPOSE_PROJECT_NAME=unstructured-minds

# For development with hot reload, use:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
