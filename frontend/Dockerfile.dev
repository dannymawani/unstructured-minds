# =============================================================================
# Unstructured Minds Frontend - Development Dockerfile
# Runs Vite dev server with hot module replacement
# =============================================================================

FROM node:22-alpine

WORKDIR /app

# Copy package files for dependency installation
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source files (will be overridden by volume mounts in dev)
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Run Vite dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
