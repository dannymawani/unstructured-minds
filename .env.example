# =============================================================================
# Unstructured Minds — Environment Configuration
# =============================================================================
#
# Copy this file to .env:   cp .env.example .env
#
# The only thing you NEED to set is an LLM API key (if you want AI features).
# Everything else has sensible defaults for local mode.
#
# =============================================================================


# =============================================================================
# 1. AI / LLM PROVIDER (Optional — app works without it)
# =============================================================================
#
# AI powers: data extraction from notes, natural language queries, insights.
# Without an API key, the app works as a normal notes + manual data app.
#
# Supported providers: anthropic, openai, ollama (or any LiteLLM-compatible)
# See: https://docs.litellm.ai/docs/providers
#

# Provider name (anthropic, openai, ollama, etc.)
# LLM_PROVIDER=anthropic

# API key for your provider
# LLM_API_KEY=sk-ant-...

# Override default models (optional — sensible defaults per provider)
# LLM_MODEL_FAST=claude-haiku-4-5-20251001
# LLM_MODEL_SMART=claude-sonnet-4-5-20250929

# Legacy: still works if you prefer setting this directly
# ANTHROPIC_API_KEY=sk-ant-...


# =============================================================================
# 2. STORAGE MODE
# =============================================================================
#
# Unstructured Minds uses TWO database engines that serve different purposes:
#
#   DuckDB  — Column-oriented analytical database. Powers fast analytical
#             queries like "what did I eat last week?" or "show my workout
#             trends". Runs embedded (no server needed), stores as a single
#             file. This is the default — zero setup required.
#
#   Postgres — Row-oriented relational database. Used for durable multi-user
#              storage when you want persistence, concurrent access, or to
#              run on a server. Postgres is the source of truth in cloud mode;
#              DuckDB runs as an in-memory analytics cache on top.
#
# In LOCAL MODE (default):
#   - DuckDB file at DATA_PATH/unstructured.duckdb
#   - Notes stored on filesystem at VAULT_PATH
#   - Zero external dependencies
#
# In POSTGRES MODE:
#   - Postgres stores all data (source of truth)
#   - DuckDB runs in-memory as an analytics cache
#   - Notes stored in Postgres (supports multi-user)
#

# Set to 'true' to use Postgres instead of local DuckDB
USE_CLOUD=false

# Postgres connection string (required when USE_CLOUD=true)
# DATABASE_URL=postgresql://um:um_dev_password@localhost:5432/unstructured_minds
#
# If using bundled Postgres (docker compose --profile postgres up):
# DATABASE_URL=postgresql://um:um_dev_password@postgres:5432/unstructured_minds


# =============================================================================
# 3. AUTHENTICATION (Optional)
# =============================================================================
#
# AUTH_MODE controls how users are identified:
#   none  — No auth, single user (default, good for local/self-hosted)
#   basic — Simple username/password from env vars (good for network access)
#   clerk — Clerk.com managed auth (multi-user SaaS deployments)
#

AUTH_MODE=none

# Basic auth credentials (only when AUTH_MODE=basic)
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=changeme

# Clerk auth (only when AUTH_MODE=clerk)
# CLERK_SECRET_KEY=sk_live_...
# CLERK_DOMAIN=your-app.clerk.accounts.dev
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...


# =============================================================================
# 4. DATA PATHS
# =============================================================================

# Path to your markdown notes vault
VAULT_PATH=./vault

# Path for data storage (DuckDB database, CSVs)
DATA_PATH=./data


# =============================================================================
# 5. SERVER
# =============================================================================

HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=3000
DEBUG=false

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# =============================================================================
# 6. BUNDLED POSTGRES (only with --profile postgres)
# =============================================================================
#
# These configure the bundled Postgres container.
# Ignored if you're using an external DATABASE_URL.
#

POSTGRES_USER=um
POSTGRES_PASSWORD=um_dev_password
POSTGRES_DB=unstructured_minds
# POSTGRES_PORT=5432


# =============================================================================
# 7. DOCKER
# =============================================================================

# For development with hot reload:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
