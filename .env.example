# Unstructured Minds Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# PATHS
# =============================================================================

# Path to your markdown notes vault
VAULT_PATH=./vault

# Path for data storage (DuckDB database, CSVs)
DATA_PATH=./data

# =============================================================================
# SERVER
# =============================================================================

# API host (0.0.0.0 for Docker, localhost for local dev)
HOST=0.0.0.0

# API port
PORT=8000

# Enable debug mode (hot reload, verbose logging)
DEBUG=false

# =============================================================================
# CLAUDE API (Optional)
# =============================================================================

# Anthropic API key for Claude integration
# Leave empty to run without AI features
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
